# Tube Clock - files that are generated or machine-specific.
# Generated copies inside lib/modified_TFT_eSPI are covered by its own .gitignore.

# ---- Firmware (PlatformIO) -------------------------------------------------------------
.pio/

# ---- Desktop app (CMake, Qt Creator, clangd) --------------------------------------------
/build/
CMakeUserPresets.json
compile_commands.json
*.user
*.user.*
.qtcreator/
.cache/

# ---- Packaging ------------------------------------------------------------------------
# Firmware bundle from scripts/collect_firmware.py (CI publishes it with each release).
/dist/
# flatpak-builder output, local repository and bundles.
/build-flatpak/
/.flatpak-builder/
/repo/
*.flatpak

# ---- Python -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/

# ---- Editors and tools ------------------------------------------------------------------
# VS Code: only the recommended extensions are shared.
.vscode/*
!.vscode/extensions.json
.idea/
.history/
*.swp
*~

# ---- Operating systems ------------------------------------------------------------------
.DS_Store
Thumbs.db
