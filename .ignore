# Keeps generated and binary content out of search tools and AI coding agents
# (ripgrep, file listings). Does NOT affect Git tracking.

# Build output
.pio/
build/
build-flatpak/
.flatpak-builder/
repo/
dist/

# Third-party code (read only when a task is about it)
app/3rdparty/
lib/modified_TFT_eSPI/Fonts/

# Generated sources
lib/clockcore/src/TzTable.cpp
test/fixtures/png_fixtures.h

# Clock face artwork and documentation media
assets/
data/
docs/**/*.jpg
docs/**/*.png
docs/**/*.pdf
docs/**/*.docx
docs/**/*.xlsx

# Binary files
*.bin
*.bmp
*.jpg
*.jpeg
*.png
*.flatpak
