# Text files use LF everywhere.
* text=auto eol=lf

# Internet shortcuts in docs/hardware are Windows files.
*.url         text eol=crlf

# Binary files: no line ending conversion or diffs.
*.bin         binary
*.bmp         binary
*.png         binary
*.jpg         binary
*.jpeg        binary
*.pdf         binary
*.docx        binary
*.xlsx        binary
*.flatpak     binary
